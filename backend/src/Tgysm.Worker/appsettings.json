{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Worker": {
    "Jobs": {
      "OutboxDispatcher": {
        "IntervalSeconds": 30,
        "BatchSize": 50,
        "LeaseSeconds": 60
      },
      "EmailSender": {
        "IntervalSeconds": 30,
        "BatchSize": 50,
        "LeaseSeconds": 60
      },
      "SlaMonitor": {
        "IntervalSeconds": 60,
        "BatchSize": 200
      },
      "Cleanup": {
        "IntervalSeconds": 3600
      }
    }
  },
  "App": {
    "PublicBaseUrl": "",
    "TimeZone": "Europe/Istanbul"
  },
  "Email": {
    "Mode": "",
    "From": "",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "UserName": "",
      "TimeoutSeconds": 30
    },
    "PickupFolder": ""
  }
}
