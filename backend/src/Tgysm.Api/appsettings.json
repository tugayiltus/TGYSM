{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "LoginPermitLimitPerMinute": 10,
    "SessionHours": 8
  },
  "Worker": {
    "Jobs": {
      "OutboxDispatcher": {
        "IntervalSeconds": 30
      },
      "EmailSender": {
        "IntervalSeconds": 30
      }
    }
  },
  "App": {
    "PublicBaseUrl": "",
    "TimeZone": "Europe/Istanbul"
  }
}
