    "@hookform/resolvers": "^5.9.1",
    "@popperjs/core": "~2.11",
    "@tanstack/react-query": "^5.104.0",
    "chart.js": "~4.5",
    "i18next": "^26.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
