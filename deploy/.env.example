# Copy to deploy/.env (never committed) and fill in. Read by tools/compose.sh (docker compose --env-file).

# Image tag: tools/deploy.sh records the deployed Git short hash in deploy/.version (git-ignored) and tools/compose.sh
# uses it; a TGYSM_VERSION in the shell environment overrides that file. Do not set TGYSM_VERSION here: the file wins.

# Deployment kind. Leave unset on a production host. Only a pilot or test host sets TGYSM_DEPLOYMENT=pilot: it allows
# tools/seed-pilot.sh --compose to write pilot data. A seeded host is never promoted to production.
# TGYSM_DEPLOYMENT=pilot

# Database password for the "tgysm" PostgreSQL user (long random value).
POSTGRES_PASSWORD=change-me

# Absolute address users open; used in links inside emails.
PUBLIC_BASE_URL=https://tgysm.example.com

# Host ports of nginx.
HTTP_PORT=80
HTTPS_PORT=443

# Container clock and the application's business time zone.
TZ=Europe/Istanbul
APP_TIME_ZONE=Europe/Istanbul

# Internal Docker network; the API trusts forwarded headers only from it.
TGYSM_SUBNET=172.28.0.0/24

# Email: Smtp in production; Pickup writes .eml files under the file store (test hosts only).
EMAIL_MODE=Smtp
EMAIL_FROM=TGYSM <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Nightly backup (tools/backup.sh runs one on demand).
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14
# Optional absolute host folder for archives (default: Docker volume "backups"). Restrict its access:
# archives contain the Data Protection keys.
BACKUP_HOST_DIR=
